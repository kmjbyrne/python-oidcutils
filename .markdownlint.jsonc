{
  // Line length: prose is wrapped by Prettier at 80, so keep the limit but
  // relax the cases that cannot be sensibly wrapped.
  "MD013": {
    // Do not flag long lines inside fenced code blocks.
    "code_blocks": false,
    // Do not flag long lines in tables (padding pushes them over).
    "tables": false,
    // "stern" mode: only fail a too-long line if it COULD be broken. A line
    // with no spaces past the limit (a bare URL or single long `inline-code`
    // token) is left alone; mixed prose+link still flags.
    "stern": true,
  },

  // MD024 (no duplicate headings), scoped to siblings. A changelog repeats
  // "### Added" once per release by design, and numbering them to satisfy the
  // strict form ("### 1. Added") reads as though the order meant something.
  //
  // Duplicates under one parent are still caught, which is the case worth
  // catching: two "### Added" in the same release is an editing mistake, two
  // in different releases is the format working.
  "MD024": { "siblings_only": true },

  // MD036 (no bold-as-heading) stays STRICT. Use real headings for labels.

  // Allow inline HTML if needed (remove to keep strict).
  "MD033": false,

  // First line need not be a top-level heading (docs pasted into Google Docs
  // tabs often start mid-content). Remove to enforce it.
  "MD041": false,
}
